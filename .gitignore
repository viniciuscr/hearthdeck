# Miscellaneous
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history/
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Rust build artifacts
/services/target/
# hearthdeck-overlay is deliberately its own standalone Cargo workspace (see
# services/hearthdeck-overlay/Cargo.toml), not a member of services/, so its
# build output lands in its own nested target/ instead of /services/target/.
/services/hearthdeck-overlay/target/
/services/hearthdeck-cosmic-spike/target/

# Arch package build output. makepkg stages the installed layout of every file
# package() installs under pkg/, unpacks sources under src/, and writes its log
# next to the PKGBUILD. All of it is regenerated by `just ci-package-arch`, and
# pkg/ alone is ~119 MB of built binaries (frontend 59 MB, overlay 41 MB,
# daemon 15 MB). Committing it once put that whole tree in the repository.
/packaging/arch/pkg/
/packaging/arch/src/
/packaging/arch/*.log
/packaging/arch/*.pkg.tar.zst

# Local Hearthdeck service state and diagnostics
/data/
/runtime/
/logs/
/tmp/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# Local service configuration and TLS material. Keep deployment templates.
/deploy/systemd/daemon.env
/deploy/systemd/*.env
!/deploy/systemd/*.env.example
/certs/
/tls/
*.pem
*.key
*.p12
*.pfx

# Development environment overrides and coverage output
.env
.env.*
!.env.example
/coverage/lcov.info
