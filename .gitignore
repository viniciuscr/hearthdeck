# Miscellaneous
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history/
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Rust build artifacts
/services/target/
# hearthdeck-overlay is deliberately its own standalone Cargo workspace (see
# services/hearthdeck-overlay/Cargo.toml), not a member of services/, so its
# build output lands in its own nested target/ instead of /services/target/.
/services/hearthdeck-overlay/target/
/services/hearthdeck-cosmic-spike/target/

# Local Hearthdeck service state and diagnostics
/data/
/runtime/
/logs/
/tmp/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal

# Local service configuration and TLS material. Keep deployment templates.
/deploy/systemd/daemon.env
/deploy/systemd/*.env
!/deploy/systemd/*.env.example
/certs/
/tls/
*.pem
*.key
*.p12
*.pfx

# Development environment overrides and coverage output
.env
.env.*
!.env.example
/coverage/lcov.info
