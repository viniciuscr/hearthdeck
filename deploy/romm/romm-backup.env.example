# Copy this to ~/.config/romm-backup.env to change the nightly dump.
# Everything is optional; the defaults match this machine.

# The MariaDB container, and where the dump goes.
# ROMM_DB_CONTAINER=romm-db
# ROMM_BACKUP_DIR=/mnt/external/romM/backups

# The mount that must be present before the dump runs.
# ROMM_BACKUP_MOUNT=/mnt/external

# Dumps to keep.
# ROMM_BACKUP_KEEP=14
