#!/usr/bin/env bash
# romm-backup - dump the RomM MariaDB database to the external disk.
#
# RomM keeps the library, resources, assets, and config on /mnt/external; only
# the database lives on the internal disk. That database is the piece a machine
# wipe destroys, so the nightly timer dumps it next to the rest of the RomM data.
#
# The credentials are read from the romm-db container's own environment, so this
# script never parses the compose file and never stores a second copy.
#
# Environment:
#   ROMM_DB_CONTAINER    database container (default romm-db)
#   ROMM_BACKUP_DIR      destination      (default /mnt/external/romM/backups)
#   ROMM_BACKUP_MOUNT    mount that must be present (default /mnt/external)
#   ROMM_BACKUP_KEEP     dumps to retain  (default 14)
#   ROMM_BACKUP_DRY_RUN  1 to check the guards without writing
set -euo pipefail

CONTAINER=${ROMM_DB_CONTAINER:-romm-db}
DEST=${ROMM_BACKUP_DIR:-/mnt/external/romM/backups}
EXTERNAL=${ROMM_BACKUP_MOUNT:-/mnt/external}
KEEP=${ROMM_BACKUP_KEEP:-14}
DRY_RUN=${ROMM_BACKUP_DRY_RUN:-0}

die() { echo "romm-backup: $*" >&2; exit 1; }

for cmd in podman gzip findmnt flock; do
  command -v "$cmd" >/dev/null || die "$cmd is not installed"
done

[[ $KEEP =~ ^[0-9]+$ ]] || die "ROMM_BACKUP_KEEP must be a positive integer"
(( KEEP > 0 )) || die "ROMM_BACKUP_KEEP must be a positive integer"
findmnt -rn -o TARGET -- "$EXTERNAL" >/dev/null || die "$EXTERNAL is not mounted"
podman container exists "$CONTAINER" || die "container $CONTAINER does not exist"
[[ $(podman container inspect --format '{{.State.Running}}' "$CONTAINER") == true ]] \
  || die "container $CONTAINER is not running"

# Fail before writing if the container's database credentials no longer work.
podman exec "$CONTAINER" sh -c \
  'MYSQL_PWD="$MARIADB_PASSWORD" mariadb --user="$MARIADB_USER" --database="$MARIADB_DATABASE" --execute="SELECT 1"' \
  >/dev/null || die "cannot query $CONTAINER with its MARIADB_* environment"

if [[ $DRY_RUN == 1 ]]; then
  echo "romm-backup: dry run; would dump $CONTAINER to $DEST and keep $KEEP"
  exit 0
fi

mkdir -p "$DEST"

LOCK_DIR=${XDG_CACHE_HOME:-$HOME/.cache}
mkdir -p "$LOCK_DIR"
exec 9>"$LOCK_DIR/romm-backup.lock"
flock -n 9 || die "another romm-backup run holds the lock"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
tmp="$DEST/.romm-db-$stamp.sql.gz.part"
final="$DEST/romm-db-$stamp.sql.gz"
trap 'rm -f -- "$tmp"' EXIT

echo "romm-backup: dumping $CONTAINER to $final"
# --single-transaction keeps the dump consistent without locking the live DB.
podman exec "$CONTAINER" sh -c \
  'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb-dump --user="$MARIADB_USER" --single-transaction --quick --databases "$MARIADB_DATABASE"' \
  | gzip -9 >"$tmp"

gzip -t "$tmp" || die "dump is not valid gzip"
tables=$(gzip -dc "$tmp" | grep -c '^CREATE TABLE' || true)
(( tables >= 20 )) || die "dump has only $tables tables"
mv -- "$tmp" "$final"
trap - EXIT

# Keep the newest $KEEP dumps and leave every other file in the directory alone.
mapfile -t dumps < <(
  find "$DEST" -maxdepth 1 -type f -name 'romm-db-*.sql.gz' -printf '%T@ %p\n' \
    | sort -rn | cut -d' ' -f2-
)
for (( i = KEEP; i < ${#dumps[@]}; i++ )); do
  echo "romm-backup: pruning ${dumps[i]}"
  rm -f -- "${dumps[i]}"
done

kept=$(find "$DEST" -maxdepth 1 -type f -name 'romm-db-*.sql.gz' | wc -l)
echo "romm-backup: wrote $final ($(du -h "$final" | cut -f1), $tables tables, $kept retained)"
