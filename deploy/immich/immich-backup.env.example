# Copy this to ~/.config/immich-backup.env to change the nightly mirror.
# Everything is optional; the defaults match this machine.

# Where Immich keeps the library and its database dumps.
# IMMICH_DATA_DIR=/mnt/immich/data

# Where the second copy goes, and the mount that must be present before rsync
# runs. The script refuses to run if the mount is missing.
# IMMICH_BACKUP_DIR=/mnt/external/immich
# IMMICH_BACKUP_MOUNT=/mnt/external

# 1 also mirrors upload/, profile/ and library/. The 44 GB library makes the
# first run long; subsequent runs copy only new photos and videos. Thumbnails
# and encoded video are regenerated by Immich and are never copied.
# IMMICH_BACKUP_ORIGINALS=1
