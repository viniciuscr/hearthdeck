# Loopback development mode (the default): no LAN access and HTTP only.
# HEARTHDECK_BIND_ADDRESS=127.0.0.1:38400
# HEARTHDECK_LOCAL_ADMIN_ADDRESS=127.0.0.1:38401
#
# Android/LAN mode: require an HTTPS certificate that includes the hostname or
# IP address used by the client. Pair clients only after verifying its
# certificate fingerprint out of band.
# HEARTHDECK_LAN_ENABLED=true
# HEARTHDECK_BIND_ADDRESS=0.0.0.0:38400
# HEARTHDECK_TLS_CERT_PATH=%h/.config/hearthdeck/tls/cert.pem
# HEARTHDECK_TLS_KEY_PATH=%h/.config/hearthdeck/tls/key.pem
#
# Where RomM keeps its data on this host. The daemon reads ROMs and covers
# straight off these paths rather than streaming them through RomM's API, so it
# needs read access to both. RomM's compose file sits at the root of its data
# directory, beside the library/ and resources/ mounts, so the roots derive from
# that file's directory. Set the explicit roots only for a deployment that
# mounts them somewhere else.
# ROMM_COMPOSE_FILE=/mnt/external/romM/podman-compose.yaml
# HEARTHDECK_ROMM_LIBRARY_ROOT=/mnt/external/romM/library
# HEARTHDECK_ROMM_RESOURCES_ROOT=/mnt/external/romM/resources
# Library categorization by a local model. Nothing below has to be set: the
# daemon always provides the feature, and turning it on is the user's, from the
# Settings screen, where the download happens on the click. A machine that never
# turns it on never pays for it. Everything here is an override for an unusual
# machine, never a switch.
#
# Each scan runs in a child `hearthdeck-ai` process, which is where the
# model's memory lives: nothing stays resident between scans, and a scan only
# happens when one is asked for. There is no scan at boot.
#
# Engine: `laya` (the checkpoint, the default) or `heuristic` (the deterministic
# tables, no checkpoint at all).
# HEARTHDECK_AI_ENGINE=laya
#
# Checkpoint. The first scan fetches it: `english` is ~846 MB and
# `multilingual` ~678 MB, so the language choice is a disk choice too.
# HEARTHDECK_AI_MODEL=english
#
# A local checkpoint directory, which is how an offline install sideloads one.
# Set this and nothing is ever downloaded, and Hearthdeck never deletes it.
# HEARTHDECK_AI_MODEL_PATH=%h/.local/share/hearthdeck/models/laya
# HEARTHDECK_AI_DTYPE=float16
#
# Where a downloaded checkpoint is cached. Deliberately not the shared
# ~/.cache/huggingface, which is on whatever partition the desktop uses and is
# the first thing a cleanup tool or an image build throws away. Pointing this at
# external storage is how a small root partition survives the download.
# HEARTHDECK_AI_CACHE_DIR=%h/.local/share/hearthdeck/models/hub
#
# Where the AI binary lives, when it is not beside the daemon, which is
# where an install puts it and where the daemon looks first.
# HEARTHDECK_AI_BIN=%h/.local/bin/hearthdeck-ai
# Where the scan's library, report and progress handoff files are written.
# HEARTHDECK_CATEGORIZATION_DIR=%h/.local/share/hearthdeck/categorization
