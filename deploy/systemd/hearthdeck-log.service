[Unit]
Description=Hearthdeck session log collector
PartOf=hearthdeck.target
Before=hearthdeck-bridge.socket hearthdeck-daemon.service romm.service

[Service]
Type=simple
UMask=0077
ExecStartPre=/usr/bin/truncate --size=0 %h/hearthdeck.log
ExecStart=/usr/bin/journalctl --user --follow --since=-30s --output=short-iso --identifier=hearthdeck-session --identifier=cosmic-test-session --identifier=hearthdeck-daemon --identifier=hearthdeck-bridge --identifier=hearthdeck-overlay --identifier=romm
StandardOutput=append:%h/hearthdeck.log
StandardError=append:%h/hearthdeck.log

[Install]
WantedBy=hearthdeck.target