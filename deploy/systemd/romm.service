[Unit]
Description=RomM Podman Compose stack
Documentation=file:///usr/share/doc/hearthdeck/ROMM.md
PartOf=hearthdeck.target
# No `After=network-online.target`: that target does not exist in the user manager
# (`systemctl --user show network-online.target` -> `not-found`), so the ordering
# it looks like it provides is not real. What this unit actually needs to wait for
# is the mount holding the compose file, and a user unit cannot order after a
# system mount - see romm.path, which starts the stack when the file appears.
# Arms the watcher from here, not only from hearthdeck.target's own Wants=, so
# that whichever target pulls this unit in - including an older packaged one
# with the romm Wants= supplied by a drop-in - also arms romm.path. Without this
# a box whose compose file appears after the session starts is never retried.
Wants=romm.path hearthdeck-romm-discover.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=ROMM_COMPOSE_FILE=/mnt/external/romM/podman-compose.yaml
EnvironmentFile=-%h/.config/hearthdeck/romm.env
ExecCondition=/usr/bin/test -f ${ROMM_COMPOSE_FILE}
ExecStartPre=/usr/bin/echo Starting RomM Podman Compose stack
# $ROMM_COMPOSE_ARGS is whitespace-split by systemd into separate arguments and
# expands to nothing when unset, so romm.env can add override compose files
# without touching the base one - e.g. `-f %h/.config/hearthdeck/romm-hostnet.yaml`
# on a host where podman's default pasta networking cannot open /dev/net/tun.
ExecStart=/usr/bin/podman-compose -f ${ROMM_COMPOSE_FILE} $ROMM_COMPOSE_ARGS up -d
ExecStop=/usr/bin/podman-compose -f ${ROMM_COMPOSE_FILE} $ROMM_COMPOSE_ARGS down
ExecStopPost=/usr/bin/echo RomM Podman Compose stack stopped
# A first `up` may need to pull the stack's images. 300s was observed to time out
# on a cold machine - the unit's own journal shows a start that failed after
# exactly 300s and then succeeded on the next attempt. The session does not wait
# on this unit, so a longer bound only lets a slow pull finish instead of failing
# the start and leaving a half-created stack behind.
TimeoutStartSec=900
TimeoutStopSec=300
# Deliberately no restart policy here. This unit wraps `podman-compose up -d`,
# which "converges" a stack by recreating any container whose config differs
# from the compose files - including containers a previous `up` already got
# running. Auto-retrying a failed up therefore recreates (and can leave down) a
# stack that was fine, instead of fixing anything. A failure stays failed and
# visible until the user acts on it.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=romm

[Install]
WantedBy=hearthdeck.target
