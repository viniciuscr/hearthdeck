[Unit]
Description=Find the RomM Compose deployment for this session
Documentation=file:///usr/share/doc/hearthdeck/ROMM.md
PartOf=hearthdeck.target
# Both consumers read ROMM_COMPOSE_FILE from ~/.config/hearthdeck/romm.env, so the
# discovery has to have finished before either of them starts - and because
# `EnvironmentFile=` is only read when a unit starts, "finished" is not enough for
# a unit that was already running.
#
# Nothing is Wants='d from here: hearthdeck.target wants this unit, and each
# consumer wants it too, so whoever pulls a consumer in also pulls this in - which
# is what makes it work on a host whose hearthdeck.target predates this unit and
# gets its dependencies from a drop-in.
Before=hearthdeck-daemon.service romm.service

[Service]
Type=oneshot
ExecStart=/usr/lib/hearthdeck/hearthdeck-romm-discover
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hearthdeck-romm-discover

[Install]
WantedBy=hearthdeck.target
