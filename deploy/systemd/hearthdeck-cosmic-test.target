[Unit]
Description=Hearthdeck COSMIC (Test) session prerequisites
Documentation=file:///usr/share/doc/hearthdeck/KIOSK-SESSION.md
# Do not start hearthdeck.target directly: it is already wanted by
# default.target at login. Requiring it here joins that existing start job,
# while these explicit requirements make the test session wait for the local
# socket and the daemon's READY=1 notification instead of racing them.
Requires=hearthdeck.target
Requires=hearthdeck-bridge.socket hearthdeck-daemon.service
After=hearthdeck.target hearthdeck-bridge.socket hearthdeck-daemon.service
