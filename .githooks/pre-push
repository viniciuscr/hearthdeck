#!/bin/bash
# Pre-push hook: validate code before pushing to remote.
#
# The checks themselves live in `just pre-push-check`, which is the single
# definition of the pre-push gate. This hook only invokes it. Duplicating the
# cargo commands here is how the hook previously drifted out of sync with the
# justfile and ended up checking a crate that no longer exists.
#
# Enable with:    git config core.hooksPath .githooks
# Skip once with: git push --no-verify

set -e

if ! command -v just >/dev/null 2>&1; then
    echo "✗ 'just' is not installed, so the pre-push gate cannot run."
    echo ""
    echo "Install the project toolchains with:"
    echo "  just setup        # or: mise install"
    echo ""
    echo "To skip this check for one push (not recommended):"
    echo "  git push --no-verify"
    exit 1
fi

if just pre-push-check; then
    exit 0
fi

echo ""
echo "Pre-push validation failed. Fix the issues above and try again."
echo ""
echo "To skip this check for one push (not recommended):"
echo "  git push --no-verify"
exit 1
