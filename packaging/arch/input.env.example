# Copy to ~/.config/hearthdeck/input.env; restart the whole session after edits.
# Keep plain shell/systemd KEY=value assignments. Legacy is the release default.
HEARTHDECK_INPUT_MODE=legacy
# Broker game keyboard: executable, foreground, exits only after keyboard closes.
# Do not point this at gamepad-osk --toggle (that only acknowledges a request).
HEARTHDECK_GAMEPAD_OSK_ADAPTER=
