#!/usr/bin/sh
# Gamescope is supplied by the host distribution because it must match the
# installed Mesa, Vulkan, DRM, and kernel graphics stack.
set -eu

log_path="/tmp/hearthdeck-gamescope-session-${USER:-unknown}.log"
exec >>"$log_path" 2>&1

echo "$(date -Iseconds) starting Hearthdeck Console"
echo "$(date -Iseconds) user=${USER:-unset} home=${HOME:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"
echo "$(date -Iseconds) gamescope: $(gamescope --version 2>&1 | tr '\n' ' ')"

# Hearthdeck's current Flutter GTK runner is an X11 client. Do not expose
# Gamescope's experimental Wayland client socket until the runner is migrated
# and tested against it; use the compositor's XWayland display instead.
unset WAYLAND_DISPLAY
export GDK_BACKEND=x11
export SDL_VIDEODRIVER=x11
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=x11

gamescope --backend drm --force-windows-fullscreen -- /usr/bin/hearthdeck
status=$?
echo "$(date -Iseconds) Gamescope exited with status $status"
exit "$status"
