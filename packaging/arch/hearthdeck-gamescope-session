#!/usr/bin/bash
# Gamescope is supplied by the host distribution because it must match the
# installed Mesa, Vulkan, DRM, and kernel graphics stack.
set -Euo pipefail

log_directory() {
  if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s/hearthdeck\n' "$XDG_STATE_HOME"
  elif [[ -n "${HOME:-}" ]]; then
    printf '%s/.local/state/hearthdeck\n' "$HOME"
  else
    printf '%s/hearthdeck\n' "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"
  fi
}

state_directory="$(log_directory)"
if ! mkdir -p -- "$state_directory" || ! chmod 700 -- "$state_directory"; then
  state_directory="${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}/hearthdeck"
  mkdir -p -- "$state_directory"
  chmod 700 -- "$state_directory"
fi
exec >>"$state_directory/gamescope-session.log" 2>&1

# A display manager can preserve a stale D-Bus address from another login. GTK
# application registration must use the user manager's bus for this session.
if [[ -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

echo "$(date -Iseconds) starting Hearthdeck Console"
echo "$(date -Iseconds) user=${USER:-unset} home=${HOME:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"
echo "$(date -Iseconds) dbus=${DBUS_SESSION_BUS_ADDRESS:-unset}"
echo "$(date -Iseconds) gamescope: $(gamescope --version 2>&1 | tr '\n' ' ')"

: "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"
runtime_directory="$XDG_RUNTIME_DIR/hearthdeck"
mkdir -p -- "$runtime_directory"
chmod 700 -- "$runtime_directory"
session_directory="$(mktemp -d "$runtime_directory/gamescope.XXXXXX")"
ready_pipe="$session_directory/ready"
mkfifo --mode=600 "$ready_pipe"

gamescope_pid=""
client_pid=""

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM

  if [[ -n "$client_pid" ]]; then
    kill "$client_pid" 2>/dev/null || true
    wait "$client_pid" 2>/dev/null || true
  fi
  if [[ -n "$gamescope_pid" ]]; then
    kill "$gamescope_pid" 2>/dev/null || true
    wait "$gamescope_pid" 2>/dev/null || true
  fi
  rm -rf -- "$session_directory"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

# Gamescope starts Xwayland asynchronously. Wait for its published endpoint
# before launching GTK, otherwise the primary client can exit before Xwayland
# accepts connections and Gamescope returns immediately to the display manager.
gamescope --backend drm --steam --force-windows-fullscreen --ready-fd "$ready_pipe" &
gamescope_pid=$!
if ! read -r -t 10 gamescope_display gamescope_wayland_display <>"$ready_pipe" || [[ "$gamescope_display" != :* ]]; then
  echo "$(date -Iseconds) Gamescope did not publish an Xwayland display"
  exit 1
fi

echo "$(date -Iseconds) Gamescope ready display=$gamescope_display wayland=$gamescope_wayland_display"
export DISPLAY="$gamescope_display"
export GAMESCOPE_WAYLAND_DISPLAY="$gamescope_wayland_display"
/usr/lib/hearthdeck/hearthdeck-console-client &
client_pid=$!

set +e
wait -n "$client_pid" "$gamescope_pid"
status=$?
set -e
echo "$(date -Iseconds) console process exited with status $status"
exit "$status"
