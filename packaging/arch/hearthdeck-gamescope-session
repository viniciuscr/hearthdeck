#!/usr/bin/bash
# Gamescope is supplied by the host distribution because it must match the
# installed Mesa, Vulkan, DRM, and kernel graphics stack.
set -Eeuo pipefail

: "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"

runtime_dir="$XDG_RUNTIME_DIR/hearthdeck"
mkdir -p -- "$runtime_dir"
chmod 700 -- "$runtime_dir"
session_dir="$(mktemp -d "$runtime_dir/gamescope.XXXXXX")"
ready_pipe="$session_dir/ready"
environment_file="$runtime_dir/console.env"
log_path="$runtime_dir/gamescope-session.log"
mkfifo --mode=600 "$ready_pipe"

gamescope_pid=""
hearthdeck_pid=""

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM

  if [[ -n "$hearthdeck_pid" ]]; then
    kill "$hearthdeck_pid" 2>/dev/null || true
    wait "$hearthdeck_pid" 2>/dev/null || true
  fi
  systemctl --user stop hearthdeck-console.slice 2>>"$log_path" || true
  systemctl --user stop hearthdeck-bridge.service 2>>"$log_path" || true
  rm -f -- "$environment_file"
  if [[ -n "$gamescope_pid" ]]; then
    kill "$gamescope_pid" 2>/dev/null || true
    wait "$gamescope_pid" 2>/dev/null || true
  fi
  rm -rf -- "$session_dir"
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

{
  echo "$(date -Iseconds) starting Hearthdeck Console"
  echo "$(date -Iseconds) user=${USER:-unset} runtime=$XDG_RUNTIME_DIR"
  echo "$(date -Iseconds) gamescope: $(gamescope --version 2>&1 | tr '\n' ' ')"
} >>"$log_path"

# Hearthdeck's current Flutter GTK runner is an X11 client. Do not expose
# Gamescope's experimental Wayland client socket until the runner is migrated
# and tested against it; use the compositor's XWayland display instead.
gamescope --backend drm --force-windows-fullscreen --ready-fd "$ready_pipe" >>"$log_path" 2>&1 &
gamescope_pid=$!

if ! read -r -t 10 gamescope_display _ <>"$ready_pipe" || [[ "$gamescope_display" != :* ]]; then
  echo "$(date -Iseconds) Gamescope did not publish an Xwayland display" >>"$log_path"
  exit 1
fi

cat >"$environment_file" <<EOF
DISPLAY=$gamescope_display
WAYLAND_DISPLAY=
GDK_BACKEND=x11
SDL_VIDEODRIVER=x11
XDG_CURRENT_DESKTOP=gamescope:hearthdeck
XDG_SESSION_DESKTOP=hearthdeck
XDG_SESSION_TYPE=x11
HEARTHDECK_CONSOLE=1
EOF
chmod 600 -- "$environment_file"

export DISPLAY="$gamescope_display"
export WAYLAND_DISPLAY=""
export GDK_BACKEND=x11
export SDL_VIDEODRIVER=x11
export XDG_CURRENT_DESKTOP=gamescope:hearthdeck
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=x11

# The bridge inherits the environment file and passes these endpoints to each
# supervised application service.
systemctl --user start hearthdeck.target >>"$log_path" 2>&1
systemctl --user restart hearthdeck-bridge.service >>"$log_path" 2>&1

/usr/bin/hearthdeck >>"$log_path" 2>&1 &
hearthdeck_pid=$!

set +e
wait -n "$hearthdeck_pid" "$gamescope_pid"
status=$?
set -e
echo "$(date -Iseconds) console process exited with status $status" >>"$log_path"
exit "$status"
