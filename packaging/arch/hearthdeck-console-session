#!/usr/bin/bash
# Start the user-service session and keep the display manager attached to it.
set -Euo pipefail

: "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"
if [[ -S "$XDG_RUNTIME_DIR/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

systemctl --user daemon-reload
systemctl --user stop hearthdeck-gamescope.target 2>/dev/null || true
systemctl --user stop graphical-session-pre.target 2>/dev/null || true
systemctl --user reset-failed
dbus-update-activation-environment --systemd \
  DESKTOP_SESSION $(env | grep '^XDG_' | cut -d= -f1)
trap 'systemctl --user stop hearthdeck-gamescope.target || true' HUP INT TERM EXIT

if ! systemctl --user start hearthdeck-gamescope.target; then
  systemctl --user status --no-pager \
    hearthdeck-gamescope.service hearthdeck-console-client.service || true
  exit 1
fi
deadline=$((SECONDS + 20))
until systemctl --user is-active --quiet hearthdeck-console-client.service; do
  if systemctl --user is-failed --quiet hearthdeck-gamescope.service \
    || systemctl --user is-failed --quiet hearthdeck-console-client.service; then
    systemctl --user status --no-pager \
      hearthdeck-gamescope.service hearthdeck-console-client.service || true
    exit 1
  fi
  if ((SECONDS >= deadline)); then
    systemctl --user status --no-pager \
      hearthdeck-gamescope.service hearthdeck-console-client.service || true
    exit 1
  fi
  sleep 1
done

while systemctl --user is-active --quiet hearthdeck-console-client.service; do
  sleep 1
done
