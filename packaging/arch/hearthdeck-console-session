#!/usr/bin/bash
# SDDM invokes a Wayland session through the user's login shell. Keep the
# display-manager entrypoint small and let systemd supervise the compositor.
set -Euo pipefail

: "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"
if [[ -S "$XDG_RUNTIME_DIR/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  systemctl --user set-environment "DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS"
fi

log_directory="${XDG_STATE_HOME:-${HOME:+$HOME/.local/state}}"
if [[ -n "$log_directory" ]] && mkdir -p -- "$log_directory/hearthdeck"; then
  exec >>"$log_directory/hearthdeck/console-session.log" 2>&1
else
  mkdir -p -- "$XDG_RUNTIME_DIR/hearthdeck"
  exec >>"$XDG_RUNTIME_DIR/hearthdeck/console-session.log" 2>&1
fi

echo "$(date -Iseconds) starting Hearthdeck Console session"
echo "$(date -Iseconds) runtime=$XDG_RUNTIME_DIR dbus=${DBUS_SESSION_BUS_ADDRESS:-unset}"

systemctl --user daemon-reload
systemctl --user stop hearthdeck-console.target 2>/dev/null || true
systemctl --user reset-failed hearthdeck-gamescope.service hearthdeck-console-client.service
trap 'systemctl --user stop hearthdeck-console.target; systemctl --user unset-environment DBUS_SESSION_BUS_ADDRESS' HUP INT TERM EXIT

systemctl --user start hearthdeck-console.target
deadline=$((SECONDS + 15))
until systemctl --user is-active --quiet hearthdeck-console-client.service; do
  if systemctl --user is-failed --quiet hearthdeck-gamescope.service \
    || systemctl --user is-failed --quiet hearthdeck-console-client.service; then
    systemctl --user status --no-pager \
      hearthdeck-gamescope.service hearthdeck-console-client.service || true
    exit 1
  fi
  if ((SECONDS >= deadline)); then
    echo "Hearthdeck Console client did not become active" >&2
    systemctl --user status --no-pager \
      hearthdeck-gamescope.service hearthdeck-console-client.service || true
    exit 1
  fi
  sleep 1
done

while systemctl --user is-active --quiet hearthdeck-console-client.service; do
  sleep 1
done
systemctl --user stop hearthdeck-console.target
