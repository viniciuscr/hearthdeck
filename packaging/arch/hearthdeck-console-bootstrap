#!/usr/bin/bash
# Start Hearthdeck through the user's interactive Xterm shell so its normal
# session environment matches the verified manual launch.
set -Euo pipefail

shell="${SHELL:-/bin/sh}"
if [[ ! -x "$shell" ]]; then
  shell=/bin/sh
fi

status=0
"$shell" -ic 'sleep 1; /usr/bin/hearthdeck' || status=$?
printf '\nHearthdeck exited with status %s. Press Ctrl+D or type exit to return to the display manager.\n' "$status"
exec "$shell" -i
