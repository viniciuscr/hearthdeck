#!/usr/bin/bash
# Xterm supplies the same interactive shell environment used for the verified
# manual launch. Always leave its output visible after Hearthdeck exits.
set -Euo pipefail

status=0
/usr/bin/hearthdeck || status=$?
printf '\nHearthdeck exited with status %s. Press Ctrl+D or type exit to return to the display manager.\n' "$status"
exec "${SHELL:-/bin/sh}" -i
