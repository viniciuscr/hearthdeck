#!/usr/bin/bash
# Bare-minimum COSMIC test session: runs cosmic-comp directly (no
# cosmic-session or settings daemon), launching the hearthdeck-frontend
# COSMIC app (the migrated cosmic-app-library UI) as its client.
# Independent of the Hearthdeck Kiosk (Gamescope) session.
set -Euo pipefail

# Preserve all session, compositor, and frontend output even after the app
# covers the greeter terminal. Find it with: journalctl -b -t cosmic-test-session
exec > >(systemd-cat -t cosmic-test-session) 2>&1

log() {
  printf '[cosmic-test-session] %s\n' "$1"
}

log "starting"

export XDG_CURRENT_DESKTOP=hearthdeck:COSMIC
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=wayland

# This session starts its own local daemon and pairs with it at runtime.
unset HEARTHDECK_BACKEND_URL HEARTHDECK_PAIRING_TOKEN

systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE || true

# Critical: daemon-reload must come after import-environment to make systemd re-read
# units with the new environment. Without it, hearthdeck.target and its services
# won't see XDG_CURRENT_DESKTOP and XDG_SESSION_TYPE, breaking environment-dependent
# logic like is_kiosk_session().
systemctl --user daemon-reload || true
log "starting hearthdeck-cosmic-test.target"
if ! systemctl --user start hearthdeck-cosmic-test.target; then
  log "hearthdeck-cosmic-test.target failed; continuing so Hearthdeck can show diagnostics"
fi
systemctl --user try-restart hearthdeck-daemon.service || true
systemctl --user try-restart hearthdeck-bridge.service || true

# Add the default COSMIC custom shortcut once. The helper is idempotent and
# refuses to replace a binding the user already assigned.
/usr/lib/hearthdeck/hearthdeck-overlay --install-shortcut || log "could not install overlay shortcut"

# The overlay is a COSMIC layer-shell client, so it is valid only in this
# separate COSMIC test session. Its restart policy absorbs the compositor's
# initial activation-environment race.
systemctl --user start hearthdeck-overlay.service || true

launch_app="/usr/bin/hearthdeck-frontend"
if [[ ! -x "$launch_app" && -x /usr/bin/hearthdeck_cosmic ]]; then
  launch_app="/usr/bin/hearthdeck_cosmic"
fi

if [[ ! -x "$launch_app" ]]; then
  log "hearthdeck-frontend binary missing: expected /usr/bin/hearthdeck-frontend"
  exit 1
fi

log "exec cosmic-comp ($launch_app)"
exec cosmic-comp "$launch_app"
