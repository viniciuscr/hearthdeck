#!/usr/bin/bash
# Bare-minimum COSMIC test session: runs cosmic-comp directly (no
# cosmic-session or settings daemon) with Hearthdeck as its sole app client.
# cosmic-panel runs alongside it as a real, dark, Panel-only, size-L top bar
# (see apply_cosmic_overrides below). Independent of the Hearthdeck Kiosk
# (Gamescope) session.
set -Euo pipefail

# Writes straight to the system journal regardless of how this session was
# launched (greetd/cosmic-greeter's own output capture is unreliable to find
# - see the "Address already in use" investigation). Find these with:
#   journalctl -t cosmic-test-session
log() {
  logger -t cosmic-test-session -- "$1" || true
}

log "starting"

export XDG_CURRENT_DESKTOP=hearthdeck:COSMIC
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=wayland

systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE || true

# Critical: daemon-reload must come after import-environment to make systemd re-read
# units with the new environment. Without it, hearthdeck.target and its services
# won't see XDG_CURRENT_DESKTOP and XDG_SESSION_TYPE, breaking environment-dependent
# logic like is_kiosk_session().
systemctl --user daemon-reload || true
log "starting hearthdeck-cosmic-test.target"
if ! systemctl --user start hearthdeck-cosmic-test.target; then
  log "hearthdeck-cosmic-test.target failed; continuing so Hearthdeck can show diagnostics"
fi
systemctl --user try-restart hearthdeck-bridge.service || true

# Add the default COSMIC custom shortcut once. The helper is idempotent and
# refuses to replace a binding the user already assigned.
/usr/lib/hearthdeck/hearthdeck-overlay --install-shortcut || log "could not install overlay shortcut"

# The overlay is a COSMIC layer-shell client, so it is valid only in this
# separate COSMIC test session. Its restart policy absorbs the compositor's
# initial activation-environment race.
systemctl --user start hearthdeck-overlay.service || true

# cosmic-panel (the top bar + dock) and cosmic-comp/cosmic-panel's own theming
# both read plain per-key files under $XDG_CONFIG_HOME/cosmic - normally
# written by cosmic-settings, which doesn't run in this minimal session. Force
# the same fixed values on every login instead of seeding them once: a
# once-only seed silently no-ops on a machine that already has a real COSMIC
# desktop login (its own entries/theme files already exist), which is exactly
# how the Dock ended up showing here despite the "Panel only" intent below.
# Trade-off: this always overwrites these specific keys, including any manual
# COSMIC Settings change made to them from a real desktop session sharing the
# same account - deliberate, since this session needs a known, reproducible
# look every time, not "whatever was left over from last time". Key meanings
# and file-format reference: docs/cosmic-panel-customization.md.
apply_cosmic_overrides() {
  local entries_dir="$HOME/.config/cosmic/com.system76.CosmicPanel/v1"
  local panel_dir="$HOME/.config/cosmic/com.system76.CosmicPanel.Panel/v1"
  local mode_dir="$HOME/.config/cosmic/com.system76.CosmicTheme.Mode/v1"
  mkdir -p "$entries_dir" "$panel_dir" "$mode_dir"
  # Panel only - no Dock, redundant with Hearthdeck's own UI.
  printf '%s' '["Panel"]' > "$entries_dir/entries"
  # Hides the bar behind whatever's currently fullscreen (Hearthdeck
  # maximizes instead of fullscreening here - see my_application.cc - so it
  # stays visible; a launched game going fullscreen hides it).
  printf '%s' 'OnOverlap' > "$panel_dir/autohide"
  # Dark, and don't auto-switch with the system clock: this session should
  # always look the same, not depend on time of day.
  printf '%s' 'true' > "$mode_dir/is_dark"
  printf '%s' 'false' > "$mode_dir/auto_switch"
  # Larger bar/icon scale.
  printf '%s' 'L' > "$panel_dir/size"
  # No left-wing or center widgets. Right wing only, ordered
  # closest-to-center-first/closest-to-edge-last per cosmic-panel's own
  # convention: Bluetooth, then Network (Wifi), then Time (Calendar) at the
  # very screen edge.
  printf '%s' 'Some(([], ["com.system76.CosmicAppletBluetooth", "com.system76.CosmicAppletNetwork", "com.system76.CosmicAppletTime"]))' > "$panel_dir/plugins_wings"
  printf '%s' 'None' > "$panel_dir/plugins_center"
}
apply_cosmic_overrides || log "could not apply cosmic-panel/theme config"
systemctl --user start cosmic-panel.service || true

log "exec cosmic-comp"
exec cosmic-comp /opt/hearthdeck/hearthdeck
