#!/usr/bin/bash
# Gamescope exposes both Xwayland and Wayland to its direct child. Hearthdeck's
# GTK runner must use Xwayland here: a direct Wayland client can negotiate the
# small virtual surface rather than the physical DRM output.
set -Euo pipefail

if [[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
  runtime_directory="$XDG_RUNTIME_DIR/hearthdeck"
  mkdir -p -- "$runtime_directory"
  umask 077
  printf '%s\n' "$GAMESCOPE_WAYLAND_DISPLAY" > "$runtime_directory/gamescope-wayland-display"
fi

exec env \
  -u WAYLAND_DISPLAY \
  GDK_BACKEND=x11 \
  XDG_SESSION_TYPE=x11 \
  vk_xwayland_wait_ready=false \
  XWAYLAND_FORCE_ENABLE_EXTRA_MODES=1 \
  SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0 \
  /opt/hearthdeck/hearthdeck
