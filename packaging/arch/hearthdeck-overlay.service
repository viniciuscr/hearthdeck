[Unit]
Description=Hearthdeck quick-menu overlay for the Hearthdeck session
Documentation=file:///usr/share/doc/hearthdeck/KIOSK-SESSION.md
# Every other service here is tied to the session's target, and this one has no
# other owner: nothing wants it and nothing stops it. Without this it outlives
# the compositor it is drawn on - a user manager that stays up across a
# sign-out keeps it running as a client of a display that is gone, which is a
# process left spinning on a dead Wayland connection until the manager itself
# exits. Tied to the target, a session boundary stops it instead.
PartOf=hearthdeck.target

[Service]
Type=exec
ExecStart=/usr/lib/hearthdeck/hearthdeck-overlay
# cosmic-comp only imports WAYLAND_DISPLAY/DISPLAY into the systemd --user
# activation environment once it's ready (see cosmic-comp's own src/
# systemd.rs), which happens after this service's first start attempt in
# packaging/arch/hearthdeck-session (it starts this unit before exec'ing
# into cosmic-comp). Restart-on-failure with a short delay lets it keep
# retrying until that environment is actually available, rather than
# needing a separate polling mechanism here. Always restart because this is a
# persistent session service; a clean unexpected exit must not disable toggles.
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hearthdeck-overlay
