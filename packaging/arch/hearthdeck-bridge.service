[Unit]
Description=Hearthdeck Linux integration bridge
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
RuntimeDirectory=hearthdeck
Environment=HEARTHDECK_LOG_FORMAT=json
Environment=RUST_LOG=hearthdeck_bridge=info
ExecStart=/usr/lib/hearthdeck/hearthdeck-bridge
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hearthdeck-bridge

[Install]
WantedBy=default.target
