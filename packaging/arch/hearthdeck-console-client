#!/usr/bin/bash
# Gamescope starts this as its primary child, so Hearthdeck controls the console
# lifetime while the bridge can launch additional applications on the same Xwayland.
set -Euo pipefail

: "${HOME:?Hearthdeck Console requires HOME}"
state_directory="${XDG_STATE_HOME:-$HOME/.local/state}/hearthdeck"
mkdir -p -- "$state_directory"
chmod 700 -- "$state_directory"
exec >>"$state_directory/console-client.log" 2>&1

export WAYLAND_DISPLAY=""
export GDK_BACKEND=x11
export SDL_VIDEODRIVER=x11
export XDG_CURRENT_DESKTOP=gamescope:hearthdeck
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=x11
export HEARTHDECK_CONSOLE=1

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM

  systemctl --user stop hearthdeck-console.slice 2>&1 || true
  systemctl --user stop hearthdeck-bridge.service 2>&1 || true
  systemctl --user unset-environment \
    DISPLAY WAYLAND_DISPLAY GDK_BACKEND SDL_VIDEODRIVER \
    XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE HEARTHDECK_CONSOLE \
    2>&1 || true
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

echo "$(date -Iseconds) starting Hearthdeck Console client"
echo "$(date -Iseconds) display=${DISPLAY:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"

# Propagate Gamescope's Xwayland endpoint to the user manager before restarting
# the bridge. A failure here must not prevent the console shell itself from opening.
if dbus-update-activation-environment --systemd \
  DISPLAY WAYLAND_DISPLAY GDK_BACKEND SDL_VIDEODRIVER \
  XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE HEARTHDECK_CONSOLE; then
  if ! systemctl --user restart hearthdeck-bridge.service; then
    echo "could not restart the bridge with the console environment" >&2
  fi
else
  echo "could not update the user-manager console environment" >&2
fi

status=0
/usr/bin/hearthdeck || status=$?
echo "$(date -Iseconds) Hearthdeck exited with status $status"
exit "$status"
