#!/usr/bin/bash
# The compositor service has already published the Xwayland environment.
set -Euo pipefail

umask 077
log_directory="${XDG_STATE_HOME:-${HOME:+$HOME/.local/state}}"
if [[ -n "$log_directory" ]] && mkdir -p -- "$log_directory/hearthdeck"; then
  exec >>"$log_directory/hearthdeck/console-client.log" 2>&1
fi
echo "$(date -Iseconds) starting Hearthdeck Console client"
echo "$(date -Iseconds) display=${DISPLAY:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"

if ! systemctl --user restart hearthdeck-bridge.service; then
  echo 'Could not restart the Hearthdeck bridge for Gamescope.' >&2
fi
exec /usr/bin/hearthdeck
