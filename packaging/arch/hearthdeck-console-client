#!/usr/bin/bash
# Gamescope starts this as its primary child, so Hearthdeck controls the console
# lifetime while the bridge can launch additional applications on the same Xwayland.
set -Euo pipefail

log_directory() {
  if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s/hearthdeck\n' "$XDG_STATE_HOME"
  elif [[ -n "${HOME:-}" ]]; then
    printf '%s/.local/state/hearthdeck\n' "$HOME"
  else
    printf '%s/hearthdeck\n' "${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}"
  fi
}

state_directory="$(log_directory)"
if ! mkdir -p -- "$state_directory" || ! chmod 700 -- "$state_directory"; then
  state_directory="${XDG_RUNTIME_DIR:?Hearthdeck Console requires XDG_RUNTIME_DIR}/hearthdeck"
  mkdir -p -- "$state_directory"
  chmod 700 -- "$state_directory"
fi
exec >>"$state_directory/console-client.log" 2>&1

export WAYLAND_DISPLAY=""
export GDK_BACKEND=x11
export SDL_VIDEODRIVER=x11
export XDG_CURRENT_DESKTOP=gamescope:hearthdeck
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=x11
export HEARTHDECK_CONSOLE=1
if [[ -S "${XDG_RUNTIME_DIR:-}/bus" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM

  systemctl --user stop hearthdeck-bridge.service 2>&1 || true
  systemctl --user stop hearthdeck-gamescope.service 2>&1 || true
  exit "$status"
}
trap cleanup EXIT HUP INT TERM

echo "$(date -Iseconds) starting Hearthdeck Console client"
echo "$(date -Iseconds) display=${DISPLAY:-unset} runtime=${XDG_RUNTIME_DIR:-unset}"
echo "$(date -Iseconds) dbus=${DBUS_SESSION_BUS_ADDRESS:-unset}"

# The bridge reads the compositor service's generated environment file.
if ! systemctl --user restart hearthdeck-bridge.service; then
  echo "could not restart the bridge with the console environment" >&2
fi

status=0
/usr/bin/hearthdeck || status=$?
echo "$(date -Iseconds) Hearthdeck exited with status $status"
exit "$status"
