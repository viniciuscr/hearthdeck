#!/usr/bin/bash
# Labwc's DRM backend has created the Wayland socket before the session client.
set -Euo pipefail

: "${WAYLAND_DISPLAY:?Hearthdeck Kiosk requires WAYLAND_DISPLAY}"
export GDK_BACKEND=wayland
export XDG_CURRENT_DESKTOP=hearthdeck:labwc:wlroots
export XDG_SESSION_DESKTOP=hearthdeck
export XDG_SESSION_TYPE=wayland
export HEARTHDECK_LABWC=1

dbus-update-activation-environment --systemd \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE HEARTHDECK_LABWC || true
systemctl --user import-environment \
  WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
  XDG_SESSION_TYPE HEARTHDECK_LABWC || true
systemctl --user unset-environment GDK_BACKEND || true
systemctl --user daemon-reload
systemctl --user try-restart hearthdeck-bridge.service || true
systemctl --user start hearthdeck.target

exec /opt/hearthdeck/hearthdeck
