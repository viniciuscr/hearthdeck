[Unit]
Description=COSMIC panel (top bar) for the COSMIC (Test) session
Documentation=file:///usr/share/doc/hearthdeck/COSMIC-PANEL-CUSTOMIZATION.md

[Service]
Type=exec
ExecStart=/usr/bin/cosmic-panel
# cosmic-comp only imports WAYLAND_DISPLAY/DISPLAY into the systemd --user
# activation environment once it's ready (see hearthdeck-overlay.service,
# started the same way from the same session script, for the same reason).
# Restart-on-failure lets this keep retrying until that environment is
# actually available, rather than needing a separate polling mechanism.
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cosmic-panel
