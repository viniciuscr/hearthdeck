#!/usr/bin/sh
# Pacman cannot safely access an already logged-in user's manager. Starting the
# launcher is the reliable point to activate the local API and bridge for them.
systemctl --user daemon-reload >/dev/null 2>&1 || true
systemctl --user start hearthdeck.target >/dev/null 2>&1 || true
exec /opt/hearthdeck/hearthdeck "$@"
