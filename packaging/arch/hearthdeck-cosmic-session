#!/usr/bin/bash
# Let COSMIC own DRM, logind, and the Wayland activation environment. Its
# startup script imports this desktop name before starting cosmic-session.target.
set -Euo pipefail

export XDG_CURRENT_DESKTOP=hearthdeck:COSMIC
export XDG_SESSION_DESKTOP=COSMIC
export XDG_SESSION_TYPE=wayland

exec /usr/bin/start-cosmic
