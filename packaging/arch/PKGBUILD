pkgname=hearthdeck
# CI supplies a monotonically increasing version for the GitHub Pages pacman
# repository. Local builds retain the current release version.
pkgver="${HEARTHDECK_PKGVER:-1.0.0}"
pkgrel="${HEARTHDECK_PKGREL:-32}"
pkgdesc='Remote-friendly TV launcher with local desktop discovery'
arch=('x86_64')
url='https://github.com/viniciuscr/hearthdeck'
license=('MIT')
depends=('gcc-libs' 'gamescope' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libxkbcommon' 'retroarch' 'sqlite' 'systemd' 'xorg-xwayland')
makedepends=('clang' 'cmake' 'just' 'libxkbcommon' 'ninja' 'pkgconf' 'rust' 'sqlite')
# RetroArch runs no emulator without a libretro core. Cores are separate
# packages upstream (docs.libretro.com/guides/download-cores: distro-packaged
# RetroArch expects cores from the package manager, not its own downloader).
# This is a starter set covering common consoles; see
# docs/retroarch-integration.md decision 3/open question 2 for the plan to
# make this on-demand instead of a fixed list.
optdepends=(
  'libretro-fceumm: RetroArch core for NES/Famicom'
  'libretro-snes9x: RetroArch core for SNES/Super Famicom'
  'libretro-genesis-plus-gx: RetroArch core for Sega Genesis/Mega Drive'
  'libretro-mgba: RetroArch core for Game Boy/Color/Advance'
  'libretro-mupen64plus-next: RetroArch core for Nintendo 64'
  'libretro-beetle-psx: RetroArch core for PlayStation'
  'libretro-desmume: RetroArch core for Nintendo DS'
  'libretro-flycast: RetroArch core for Sega Dreamcast'
  'cosmic-comp: bare-minimum "COSMIC (Test)" session, unrelated to the Hearthdeck Kiosk session'
  'cosmic-panel: real top bar for the "COSMIC (Test)" session, unrelated to the Hearthdeck Kiosk session'
)
install="${pkgname}.install"
backup=('etc/pacman.d/hearthdeck.conf')
options=('!strip' '!lto')

build() {
  local source_dir
  source_dir=$(realpath "$startdir/../..")
  cd "$source_dir"

  just ci-check
  flutter build linux --release --dart-define=HEARTHDECK_USE_LOCAL_CATALOG=true
  cargo build --manifest-path services/Cargo.toml --workspace --release
  # ponytail: reuse the workspace target dir so CI cache keeps libcosmic/iced builds.
  CARGO_TARGET_DIR=services/target cargo build --manifest-path services/hearthdeck-overlay/Cargo.toml --release
  CARGO_TARGET_DIR=services/target cargo build --manifest-path services/hearthdeck-applet-user/Cargo.toml --release
}

package() {
  local source_dir
  source_dir=$(realpath "$startdir/../..")
  cd "$source_dir"

  install -d "$pkgdir/opt/hearthdeck" "$pkgdir/usr/bin"
  cp -a build/linux/x64/release/bundle/. "$pkgdir/opt/hearthdeck/"
  install -Dm755 packaging/arch/hearthdeck "$pkgdir/usr/bin/hearthdeck"
  install -Dm755 services/target/release/hearthdeck-bridge "$pkgdir/usr/lib/hearthdeck/hearthdeck-bridge"
  install -Dm755 services/target/release/hearthdeck-daemon "$pkgdir/usr/lib/hearthdeck/hearthdeck-daemon"
  # Disposable Gamescope external-overlay spike (see
  # services/hearthdeck-overlay-spike and docs/kiosk-session.md). Remove this
  # line, and the crate, once the finding is confirmed either way.
  install -Dm755 services/target/release/hearthdeck-overlay-spike "$pkgdir/usr/bin/hearthdeck-overlay-spike"
  install -Dm755 services/target/release/hearthdeck-overlay "$pkgdir/usr/lib/hearthdeck/hearthdeck-overlay"
  install -Dm644 packaging/arch/hearthdeck.target "$pkgdir/usr/lib/systemd/user/hearthdeck.target"
  install -Dm644 packaging/arch/hearthdeck-kiosk.target "$pkgdir/usr/lib/systemd/user/hearthdeck-kiosk.target"
  install -Dm644 packaging/arch/hearthdeck-bridge.socket "$pkgdir/usr/lib/systemd/user/hearthdeck-bridge.socket"
  install -Dm644 packaging/arch/hearthdeck-bridge.service "$pkgdir/usr/lib/systemd/user/hearthdeck-bridge.service"
  install -Dm644 packaging/arch/hearthdeck-daemon.service "$pkgdir/usr/lib/systemd/user/hearthdeck-daemon.service"
  install -Dm644 deploy/systemd/daemon.env.example "$pkgdir/usr/share/doc/hearthdeck/daemon.env.example"
  install -Dm644 packaging/arch/hearthdeck-pacman-repo.conf "$pkgdir/etc/pacman.d/hearthdeck.conf"
  install -Dm644 docs/arch-package.md "$pkgdir/usr/share/doc/hearthdeck/README.md"
  install -Dm644 docs/linux-acceptance.md "$pkgdir/usr/share/doc/hearthdeck/ACCEPTANCE.md"
  install -Dm644 docs/kiosk-session.md "$pkgdir/usr/share/doc/hearthdeck/KIOSK-SESSION.md"
  install -Dm644 packaging/arch/hearthdeck.desktop "$pkgdir/usr/share/applications/io.github.viniciuscr.hearthdeck.desktop"
  install -Dm644 packaging/arch/hearthdeck-session.desktop "$pkgdir/usr/share/wayland-sessions/hearthdeck.desktop"
  install -Dm755 packaging/arch/hearthdeck-session "$pkgdir/usr/lib/hearthdeck/hearthdeck-session"
  # Bare-minimum "COSMIC (Test)" session: independent of, and not required by,
  # the Hearthdeck Kiosk session above. See packaging/arch/cosmic-test-session
  # for what it does and does not do.
  install -Dm644 packaging/arch/cosmic-test-session.desktop "$pkgdir/usr/share/wayland-sessions/cosmic-test.desktop"
  install -Dm755 packaging/arch/cosmic-test-session "$pkgdir/usr/lib/hearthdeck/cosmic-test-session"
  install -Dm644 deploy/systemd/hearthdeck-cosmic-test.target "$pkgdir/usr/lib/systemd/user/hearthdeck-cosmic-test.target"
  install -Dm644 packaging/arch/hearthdeck-overlay.service "$pkgdir/usr/lib/systemd/user/hearthdeck-overlay.service"
  install -Dm644 packaging/arch/cosmic-panel.service "$pkgdir/usr/lib/systemd/user/cosmic-panel.service"
  # COSMIC panel (cosmic-panel-bin's wrapper_space.rs) and cosmic-settings'
  # applet picker both discover applets by scanning .desktop files (not by
  # running a same-named binary directly): the file's *name* must equal the
  # app ID, cosmic-panel spawns whatever its Exec= line says, and
  # cosmic-settings only lists it if X-CosmicApplet is present. See
  # apply_cosmic_overrides in cosmic-test-session for how the app ID is wired
  # into plugins_wings, and docs/cosmic-panel-customization.md for the source
  # references this was confirmed against.
  install -Dm755 services/target/release/hearthdeck-applet-user "$pkgdir/usr/bin/io.github.viniciuscr.hearthdeck.AppletUser"
  install -Dm644 packaging/arch/hearthdeck-applet-user.desktop "$pkgdir/usr/share/applications/io.github.viniciuscr.hearthdeck.AppletUser.desktop"
  install -Dm644 macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.viniciuscr.hearthdeck.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
