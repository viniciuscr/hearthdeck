#!/usr/bin/sh
# Find the RomM Compose deployment on this host and record it where every
# consumer reads it: ~/.config/hearthdeck/romm.env.
#
# The session runs this every time, because which compose file exists - and
# whether the mount holding it is up yet - is host state, not install state, so
# it cannot be decided once at package install. Nothing here is required for the
# session to work: not finding RomM is a normal outcome, and the list of places
# it looked is the point of what it prints.
set -eu

config_dir=${XDG_CONFIG_HOME:-"$HOME/.config"}/hearthdeck
env_file=$config_dir/romm.env
default_path=/mnt/external/romM/podman-compose.yaml

say() { printf 'hearthdeck-romm-discover: %s\n' "$*"; }

# What is configured right now, read without sourcing the file: a malformed
# romm.env must not be able to take the session's discovery step down with it.
configured=$(sed -n 's/^ROMM_COMPOSE_FILE=[[:space:]]*//p' "$env_file" 2>/dev/null | tail -n1 || true)
if [ -n "$configured" ] && [ -f "$configured" ]; then
  say "already configured: $configured"
  exit 0
fi
say "configured path ${configured:-<none>} is not a file; searching"

# Every candidate is reported, found or not, so one paste of the log answers
# "where did it look" without anyone running anything.
found=
for candidate in \
  "$HOME/Games/romM/podman-compose.yaml" \
  "$HOME/romM/podman-compose.yaml" \
  "$HOME/romm/podman-compose.yaml" \
  "$default_path" \
  "/srv/romM/podman-compose.yaml" \
  "/opt/romM/podman-compose.yaml"
do
  if [ -f "$candidate" ]; then
    say "found: $candidate"
    found=$candidate
    break
  fi
  say "not found: $candidate"
done

# Last resort: an existing stack names its own compose file in a container
# label, which survives restarts even when the file sits somewhere nobody would
# guess. This is the case that cannot be covered by a fixed candidate list.
if [ -z "$found" ] && command -v podman >/dev/null 2>&1; then
  labels=$(podman ps -a --format '{{.Labels}}' 2>/dev/null || true)
  if [ -n "$labels" ]; then
    for candidate in $(printf '%s' "$labels" | tr ',;' '\n\n' | sed -n 's/^[^=]*=//p' | grep -E '\.ya?ml$' || true); do
      if [ -f "$candidate" ]; then
        say "found via a podman container label: $candidate"
        found=$candidate
        break
      fi
    done
  fi
fi

if [ -z "$found" ]; then
  say "no RomM compose file found; the stack cannot be started"
  say "point ROMM_COMPOSE_FILE in $env_file at it to override the search"
  exit 0
fi

# Record it for every consumer. romm.service and hearthdeck-daemon both load this
# file, so writing it once here is what makes them agree on the same deployment.
mkdir -p "$config_dir"
if [ -f "$env_file" ]; then
  # Keep everything else in the file - a hostnet override, comments - and replace
  # only this one setting.
  tmp=$(mktemp "$env_file.XXXXXX")
  grep -v '^ROMM_COMPOSE_FILE=' "$env_file" > "$tmp" || true
  printf 'ROMM_COMPOSE_FILE=%s\n' "$found" >> "$tmp"
  chmod --reference="$env_file" "$tmp" 2>/dev/null || chmod 600 "$tmp"
  mv "$tmp" "$env_file"
else
  ( umask 077; printf 'ROMM_COMPOSE_FILE=%s\n' "$found" > "$env_file" )
fi
say "wrote $env_file (ROMM_COMPOSE_FILE=$found)"
