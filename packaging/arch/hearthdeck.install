# The account a transaction belongs to. pacman runs as root, so this is the user
# that invoked sudo; `logname` reads the controlling terminal as a fallback. The
# same resolution `hearthdeck-autologin` uses for the user it writes into
# greetd's configuration.
invoking_user() {
  local candidate=${SUDO_USER:-}
  if [ -z "$candidate" ]; then
    candidate=$(logname 2>/dev/null || true)
  fi
  printf '%s' "$candidate"
}

# Run `systemctl --user` inside USER's own manager. A root transaction cannot use
# a logged-in manager directly, but pointing `systemctl --user` at the user's
# runtime directory is the supported way in - and it is what lets the package
# apply its own install or upgrade instead of handing the user a command to run.
user_systemctl() {
  local user="$1" uid="$2"
  shift 2
  runuser -u "$user" -- env \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user "$@"
}

# Make the transaction take effect inside the session that is already running,
# with nothing left for the user to do. Replacing the unit files on disk is not
# enough by itself: a running manager keeps the definitions it already loaded -
# including a `hearthdeck.target` from before RomM existed, which wants no
# `romm.service` at all - and a running service keeps executing the old binary.
refresh_user_services() {
  local user uid
  user=$(invoking_user)
  [ -n "$user" ] || return 0
  [ "$user" != root ] || return 0
  uid=$(id -u "$user" 2>/dev/null) || return 0
  # No runtime directory means no manager to talk to: nobody is logged in, and
  # the next session start reads the new units by itself.
  [ -d "/run/user/$uid" ] || return 0

  # Re-read before doing anything else: the definition being replaced may be the
  # one that decides what this user's session runs.
  user_systemctl "$user" "$uid" daemon-reload 2>/dev/null || true

  # `try-restart` leaves a unit the user never started alone, so none of this
  # starts a Hearthdeck session for someone who is not in one.
  # hearthdeck-input.service is deliberately absent: it only lives inside a
  # managed launch, where restarting it would drop the controller mapping it is
  # applying. Its next launch picks the new binary up anyway.
  user_systemctl "$user" "$uid" try-restart \
    hearthdeck-daemon.service hearthdeck-bridge.service 2>/dev/null || true

  # The RomM units are started outright rather than try-restarted: a stack a
  # previous session already has running must not be torn down and rebuilt by an
  # upgrade. `start` is a no-op on the ones already up, runs `podman-compose up
  # -d` on the ones that are not, and `romm.path` arms the watcher for a compose
  # file that is not there yet. Separate calls so a unit this host does not have
  # cannot stop the other from starting; both skip cleanly with no deployment.
  user_systemctl "$user" "$uid" start romm.path 2>/dev/null || true
  user_systemctl "$user" "$uid" start romm.service 2>/dev/null || true

  return 0
}

# Names the units whose copies in the user's own config directory shadow the ones
# this package installs. A copy there wins over /usr/lib/systemd/user, so an
# upgrade that fixes a unit has no effect until that copy is gone - which is worth
# saying out loud at the moment it happens, and only then.
shadowing_units() {
  local user home unit
  user=$(invoking_user)
  [ -n "$user" ] || return 0
  home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
  [ -n "$home" ] || return 0
  for unit in hearthdeck.target hearthdeck-log.service hearthdeck-daemon.service \
    hearthdeck-bridge.socket hearthdeck-bridge.service hearthdeck-input.service \
    hearthdeck-overlay.service romm.service romm.path; do
    if [ -e "$home/.config/systemd/user/$unit" ]; then
      printf '  %s\n' "$home/.config/systemd/user/$unit"
    fi
  done
}

post_install() {
  # Fixed loopback ports cannot be shared by every user manager (including
  # display-manager greeter accounts). Hearthdeck launchers start this target
  # explicitly for the active user.
  systemctl --global disable hearthdeck.target 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
  modprobe uinput 2>/dev/null || true
  udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
  # The optional romm.service runs `podman-compose up`, and podman's default
  # (pasta) networking opens /dev/net/tun. Same shape of need as uinput above:
  # best-effort load so a host that ships tun as a module gets it, and never a
  # hard failure on hosts where tun is built in or absent.
  modprobe tun 2>/dev/null || true
  if ! grep -qxF 'Include = /etc/pacman.d/hearthdeck.conf' /etc/pacman.conf; then
    cat >>/etc/pacman.conf <<'EOF'

# BEGIN HEARTHDECK PACMAN REPOSITORY
Include = /etc/pacman.d/hearthdeck.conf
# END HEARTHDECK PACMAN REPOSITORY
EOF
  fi

  # Autologin is the intended mode for a TV box, not a personal desktop. Point
  # greetd at the Hearthdeck session for the user who ran the install so a
  # keyboardless machine boots straight into Hearthdeck. Non-fatal: a host with
  # no cosmic-greeter (or no discoverable invoking user) must still finish the
  # package transaction.
  if [ -f /etc/greetd/cosmic-greeter.toml ]; then
    /usr/lib/hearthdeck/hearthdeck-autologin enable || true
  fi

  # Installing and upgrading are the same thing to the user: both must leave a
  # working session behind, so both reload and restart the services here rather
  # than asking for a command to be run or a sign-out.
  refresh_user_services

  cat <<'EOF'
Hearthdeck installs systemd user units for its API daemon and host bridge, and
a "Hearthdeck" Wayland session (cosmic-comp with Hearthdeck fullscreen as its
only client).

The Hearthdeck launchers and session start the local-service target for the
active user, and this package has just reloaded and restarted those services in
any session that was already running. Nothing needs to be started or reloaded by
hand. The RomM unit starts with the session too.

On a greetd host (cosmic-greeter), autologin into the Hearthdeck session was
enabled in /etc/greetd/cosmic-greeter.toml. A reboot, or
`sudo rm -f /run/greetd.run && sudo systemctl restart display-manager`, makes
greetd use it. Run `/usr/lib/hearthdeck/hearthdeck-autologin disable` to get the
login screen back; `--help` covers other users and session commands.

The launcher pairs with the loopback daemon automatically. Optional LAN/TLS
configuration belongs in ~/.config/hearthdeck/daemon.env; see
/usr/share/doc/hearthdeck/daemon.env.example.

The Hearthdeck session starts the Podman Compose RomM deployment at
/mnt/external/romM/podman-compose.yaml when that file exists, and starts it later
in the session if an external mount brings the file in after login. To point it
at a deployment somewhere else, copy
/usr/share/doc/hearthdeck/romm.env.example to ~/.config/hearthdeck/romm.env and
edit ROMM_COMPOSE_FILE.

Combined session logs are written to ~/hearthdeck.log; the packaged
/usr/lib/hearthdeck/linux-acceptance re-checks the installed services, RomM
stack, API, and logs on a host where that needs confirming.

Future Hearthdeck package updates arrive through `pacman -Syu`. The GitHub
Pages repository is unsigned and should not be enabled on systems that require
signed packages.
EOF

  shadowing=$(shadowing_units)
  if [ -n "$shadowing" ]; then
    cat <<EOF

This account still has its own copies of Hearthdeck units, left by an older
`just install-services` or by hand. A copy in ~/.config/systemd/user overrides
the packaged one, so unit fixes in this package do not reach the session while
they exist:

$shadowing
Delete those files (or keep the differences in a drop-in) to run the packaged
units.
EOF
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  sed -i '/^# BEGIN HEARTHDECK PACMAN REPOSITORY$/,/^# END HEARTHDECK PACMAN REPOSITORY$/d' /etc/pacman.conf
}

post_remove() {
  systemctl --global disable hearthdeck.target

  # The units are gone from disk now, but a running manager still has them
  # loaded and running. Stop them here for the same reason post_install starts
  # them: the user should not have to clean up after the package manager.
  local user uid
  user=$(invoking_user)
  if [ -n "$user" ] && [ "$user" != root ]; then
    uid=$(id -u "$user" 2>/dev/null || true)
    if [ -n "$uid" ] && [ -d "/run/user/$uid" ]; then
      user_systemctl "$user" "$uid" stop hearthdeck.target 2>/dev/null || true
    fi
  fi

  cat <<'EOF'
Hearthdeck's user services were stopped for the account that removed the
package. Any other account that was running them keeps them until it signs out.
EOF
}
