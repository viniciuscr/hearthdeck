#!/usr/bin/sh
# Bring the RomM Podman Compose stack up or down for this session.
#
# One job, done plainly: check that podman, podman-compose and the compose file
# are actually there, run `podman-compose up -d`, and say out loud what happened.
# Every line goes to the unit's journal, which hearthdeck-log.service mirrors into
# ~/hearthdeck.log, so a stack that did not come up explains itself without
# anyone reaching for journalctl first.
#
# There is deliberately no ExecCondition on the unit: a condition that is not met
# is a *silent* skip (docs/units-and-logs.md, Rule 1), which is the failure this
# replaced. Every outcome is logged here instead.
set -eu

env_file=${XDG_CONFIG_HOME:-"$HOME/.config"}/hearthdeck/romm.env
default_path=/mnt/external/romM/podman-compose.yaml

# The path the unit resolved for us: `Environment=ROMM_COMPOSE_FILE=` plus the
# `EnvironmentFile=-%h/.config/hearthdeck/romm.env` on romm.service.
compose=${ROMM_COMPOSE_FILE:-$default_path}

say() { printf 'hearthdeck-romm: %s\n' "$*"; }

# Is the deployment runnable at all? Podman must be installed *and* its service
# actually answering - `podman info` talks to the socket/API, so it fails when
# the daemon is down or the user is not in the rootless socket's group.
require_tools() {
  if ! command -v podman >/dev/null 2>&1; then
    say "podman is not installed; cannot manage the stack at $compose"
    return 1
  fi
  if ! command -v podman-compose >/dev/null 2>&1; then
    say "podman-compose is not installed; cannot manage the stack at $compose"
    return 1
  fi
  if ! timeout 15 podman info >/dev/null 2>&1; then
    say "podman is installed but not running; start it and retry ($compose)"
    return 1
  fi
  return 0
}

case ${1:-} in
up)
  # No compose file is not an error: it is either a host without RomM or an
  # external mount that has not landed yet, and romm.path re-runs `up` the moment
  # it appears. Say so rather than skipping silently.
  if [ ! -f "$compose" ]; then
    say "no compose file at $compose; nothing to start (romm.path retries when it appears)"
    exit 0
  fi
  say "starting the stack from $compose"
  if ! require_tools; then
    exit 1
  fi
  # $ROMM_COMPOSE_ARGS is argv (extra `-f` overrides, a hostnet switch), so it
  # must be split into words - and must vanish when unset. Unquoted expansion is
  # exactly that; a `${ROMM_COMPOSE_ARGS}` spelling passes one empty argument and
  # breaks the common no-override case.
  # shellcheck disable=SC2086
  if podman-compose -f "$compose" ${ROMM_COMPOSE_ARGS:-} up -d; then
    say "stack is up"
  else
    status=$?
    say "podman-compose up failed (status $status); the stack did not start"
    exit "$status"
  fi
  ;;
down)
  if [ ! -f "$compose" ]; then
    say "nothing to stop: $compose is gone"
    exit 0
  fi
  if ! require_tools; then
    exit 1
  fi
  say "stopping the stack from $compose"
  # shellcheck disable=SC2086
  podman-compose -f "$compose" ${ROMM_COMPOSE_ARGS:-} down ||
    say "podman-compose down reported a failure"
  ;;
*)
  say "usage: hearthdeck-romm up|down" >&2
  exit 2
  ;;
esac
